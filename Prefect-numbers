#include<iostream>
#include<cmath> 
using namespace std;

int main()
{
    int limit;
    cin >> limit;

   
    for (int n = 1; n <= limit; n++) {
        long long sum = 0; 
        
      
        for (int i = 1; i <= sqrt(n); i++) {
            if (n % i == 0) {
               
                sum += i;
                
            
                if (i != 1 && i != n / i) {
                    sum += n / i;
                }
            }
        }
        
      
        if (sum == n && n != 1) { 
            cout << n << endl;
        }
    }
    return 0;
}
